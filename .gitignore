# Dependencies
node_modules/

# Environment & secrets (ne jamais committer)
.env
.env.*
!.env.example

# Données emails (JSONL, metadata, groupes — stockés localement par l'app)
*.jsonl
*_emails.jsonl
*_sync_metadata.json
*_groups.json

# EXCEPTION — jeu de démonstration versionné.
# Les règles ci-dessus protègent les vraies données de l'utilisateur ; elles
# avalaient aussi, silencieusement, les fixtures de `npm run demo`. Le dossier
# src/public/demo/ ne contient QUE des données fictives générées par
# scripts/generate-demo-data.js (domaines @example.com / @example.org).
# La négation est volontairement limitée à ce dossier : ne pas l'élargir.
!src/public/demo/
!src/public/demo/*.jsonl
.temp
*.temp

# Logs & debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE / éditeurs
.idea/
.vscode/
*.swp
*.swo
*~

# Python (si utilisé, ex. python_analyzer)
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/
env/

# Build / sorties
dist/
build/
*.tgz

# Optionnel : dossiers de test locaux (si vous en créez à la racine)
test-data/
fixtures/local/
