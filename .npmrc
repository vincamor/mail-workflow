# Refuse to install any dependency that does not support this project's Node
# floor (see "engines" in package.json — currently >=20).
#
# Without this, npm only prints an EBADENGINE *warning* and installs anyway, so
# a dependency quietly raising the floor sails through CI: the test suite passes
# on Node 20 because nothing exercises the offending package, and the breakage
# only surfaces for someone self-hosting on Node 20.
#
# That is not hypothetical — it is exactly what connect-redis@10 did
# (engines.node ">=22"). This turns that warning into a failed install, on every
# machine and in CI.
#
# If you deliberately raise the Node floor, update "engines" in package.json
# first, then .nvmrc, the CI matrix, scripts/setup.js, scripts/doctor.js and the
# README requirements — all six, or the project starts contradicting itself.
engine-strict=true
