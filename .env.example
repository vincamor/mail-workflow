# =============================================================================
# Mail Workflow — environment template
# Copy to .env and fill in the values. NEVER commit .env.
# =============================================================================

# Required in production (session cookie). In dev, falls back to "dev_secret" if empty.
SESSION_SECRET=

# Public origin of the app, used for CORS (e.g. https://your-app.up.railway.app).
# Defaults to http://localhost:3000 if unset.
APP_ORIGIN=

# Redis for session persistence. Optional in dev (in-memory sessions otherwise).
# Local: redis://localhost:6379  |  Prod: URL from Railway / Upstash
REDIS_URL=

# Server port (default 3000).
PORT=3000

# Set to "production" when hosting. In production SESSION_SECRET is required.
# NODE_ENV=production

# --- Gmail OAuth (Google Cloud Console) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/gmail/callback

# --- Outlook OAuth (Azure AD) ---
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=common
OUTLOOK_REDIRECT_URI=http://localhost:3000/outlook/callback

# --- AI proxy (/api/ai/*) ---
# Allow a LOCAL Ollama endpoint (127.0.0.1:11434) through the anti-SSRF guard.
# Leave unset in production; set to "true" only for local Ollama use.
ALLOW_LOCAL_AI=
# Extra allowed local host:port for Ollama (comma-separated), optional.
# LOCAL_AI_ALLOWED_HOSTS=127.0.0.1:11434,localhost:11434
# Optional shared key required from clients calling an Ollama provider.
OLLAMA_API_KEY=
